{
  "$schema": "https://static.modelcontextprotocol.io/schemas/2025-12-11/server.schema.json",
  "name": "io.github.JaviMaligno/postgresql",
  "title": "PostgreSQL MCP Server",
  "description": "Secure PostgreSQL querying, schema exploration, analysis, and named multi-database access.",
  "repository": {
    "url": "https://github.com/JaviMaligno/postgres_mcp",
    "source": "github"
  },
  "version": "1.1.0",
  "packages": [
    {
      "registryType": "npm",
      "identifier": "@javiagui/postgresql-mcp",
      "version": "1.1.0",
      "transport": {
        "type": "stdio"
      },
      "environmentVariables": [
        {
          "name": "POSTGRES_CONNECTIONS",
          "description": "JSON array of named database connections",
          "isRequired": false,
          "format": "string",
          "isSecret": true
        },
        {
          "name": "POSTGRES_HOST",
          "description": "PostgreSQL host for single-database configuration",
          "isRequired": false,
          "format": "string",
          "isSecret": false
        },
        {
          "name": "POSTGRES_PORT",
          "description": "PostgreSQL port (default: 5432)",
          "isRequired": false,
          "format": "string",
          "isSecret": false
        },
        {
          "name": "POSTGRES_USER",
          "description": "PostgreSQL user for single-database configuration",
          "isRequired": false,
          "format": "string",
          "isSecret": false
        },
        {
          "name": "POSTGRES_PASSWORD",
          "description": "PostgreSQL password for single-database configuration",
          "isRequired": false,
          "format": "string",
          "isSecret": true
        },
        {
          "name": "POSTGRES_DB",
          "description": "PostgreSQL database for single-database configuration",
          "isRequired": false,
          "format": "string",
          "isSecret": false
        },
        {
          "name": "POSTGRES_SSLMODE",
          "description": "PostgreSQL SSL mode (default: prefer)",
          "isRequired": false,
          "format": "string",
          "isSecret": false
        },
        {
          "name": "ALLOW_WRITE_OPERATIONS",
          "description": "Enable INSERT, UPDATE, and DELETE (default: false)",
          "isRequired": false,
          "format": "string",
          "isSecret": false
        },
        {
          "name": "QUERY_TIMEOUT",
          "description": "Query timeout in seconds (default: 30)",
          "isRequired": false,
          "format": "string",
          "isSecret": false
        },
        {
          "name": "MAX_ROWS",
          "description": "Maximum returned rows (default: 1000)",
          "isRequired": false,
          "format": "string",
          "isSecret": false
        }
      ]
    },
    {
      "registryType": "pypi",
      "identifier": "postgresql-mcp",
      "version": "1.1.0",
      "transport": {
        "type": "stdio"
      },
      "environmentVariables": [
        {
          "name": "POSTGRES_CONNECTIONS",
          "description": "JSON array of named database connections",
          "isRequired": false,
          "format": "string",
          "isSecret": true
        },
        {
          "name": "POSTGRES_HOST",
          "description": "PostgreSQL host for single-database configuration",
          "isRequired": false,
          "format": "string",
          "isSecret": false
        },
        {
          "name": "POSTGRES_PORT",
          "description": "PostgreSQL port (default: 5432)",
          "isRequired": false,
          "format": "string",
          "isSecret": false
        },
        {
          "name": "POSTGRES_USER",
          "description": "PostgreSQL user for single-database configuration",
          "isRequired": false,
          "format": "string",
          "isSecret": false
        },
        {
          "name": "POSTGRES_PASSWORD",
          "description": "PostgreSQL password for single-database configuration",
          "isRequired": false,
          "format": "string",
          "isSecret": true
        },
        {
          "name": "POSTGRES_DB",
          "description": "PostgreSQL database for single-database configuration",
          "isRequired": false,
          "format": "string",
          "isSecret": false
        },
        {
          "name": "POSTGRES_SSLMODE",
          "description": "PostgreSQL SSL mode (default: prefer)",
          "isRequired": false,
          "format": "string",
          "isSecret": false
        },
        {
          "name": "ALLOW_WRITE_OPERATIONS",
          "description": "Enable INSERT, UPDATE, and DELETE (default: false)",
          "isRequired": false,
          "format": "string",
          "isSecret": false
        },
        {
          "name": "QUERY_TIMEOUT",
          "description": "Query timeout in seconds (default: 30)",
          "isRequired": false,
          "format": "string",
          "isSecret": false
        },
        {
          "name": "MAX_ROWS",
          "description": "Maximum returned rows (default: 1000)",
          "isRequired": false,
          "format": "string",
          "isSecret": false
        }
      ]
    }
  ]
}
