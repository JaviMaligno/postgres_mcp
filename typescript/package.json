{
  "name": "@javimaligno/postgresql-mcp",
  "version": "1.1.0",
  "publishConfig": {
    "access": "public"
  },
  "mcpName": "io.github.JaviMaligno/postgresql",
  "description": "MCP server for PostgreSQL database operations - query, explore schemas, and analyze tables",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "postgresql-mcp": "dist/index.js"
  },
  "scripts": {
    "build": "tsup src/index.ts --format esm --dts --clean",
    "dev": "tsup src/index.ts --format esm --watch",
    "start": "node dist/index.js",
    "pretest": "npm run build",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint src/",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "mcp",
    "postgresql",
    "postgres",
    "database",
    "claude",
    "ai",
    "llm",
    "model-context-protocol"
  ],
  "author": "Javier Aguilar <javiecija96@gmail.com>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/JaviMaligno/postgres_mcp"
  },
  "homepage": "https://github.com/JaviMaligno/postgres_mcp#readme",
  "bugs": {
    "url": "https://github.com/JaviMaligno/postgres_mcp/issues"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "dependencies": {
    "@modelcontextprotocol/server": "^2.0.0",
    "pg": "^8.12.0",
    "zod": "^4.2.0"
  },
  "devDependencies": {
    "@modelcontextprotocol/client": "^2.0.0",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@types/node": "^20.0.0",
    "@types/pg": "^8.11.0",
    "eslint": "^9.39.5",
    "tsup": "^8.0.0",
    "typescript": "^5.4.0",
    "typescript-eslint": "^8.65.0",
    "vitest": "^2.0.0"
  }
}
